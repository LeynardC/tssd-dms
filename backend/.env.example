APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# MUST be true in any environment served over HTTPS, or the session cookie
# is sent over plain HTTP. Leave false only for local http://localhost dev.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SPA / API wiring -------------------------------------------------------
# Origin of the Vue frontend. Used for OAuth redirects back to the SPA.
FRONTEND_URL=http://localhost:5173
# Comma-separated. Origins allowed to make credentialed calls to this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated hosts (no scheme) that receive the stateful session cookie.
# Must include the frontend host, or login "succeeds" but every later call 401s.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Comma-separated full origins allowed to register/use passkeys (WebAuthn).
PASSKEY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google sign-in (optional) --------------------------------------------
# Leave blank to disable the "Sign in with Google" path entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
